# LLM Configuration (OpenAI 兼容)
# cli-sample 用 OPENAI_* 三件套, 任意兼容端点都通。
#
# ⚠️ 三项都必须填写。只填 API Key 时，SDK 会在启动时报：
#   ValueError: service url is required but not given
#
# 如果使用自建/课程 LLM 端点，把 OPENAI_BASE_URL / OPENAI_MODEL 改成对应值。

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
